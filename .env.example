# Undertone — development configuration
#
# Copy this file to `.env` (which is git-ignored) and fill in what you need.
# `.env` is read only when running from source (`npm start` / `npm run dev`).
# In the packaged app, add your key in Settings → AI provider instead; it is
# stored encrypted with the operating system's secure storage.
#
# Every value here is optional. With no key at all the app runs in Mock mode.

# API key for Anthropic (used when the provider is "Anthropic").
ANTHROPIC_API_KEY=

# API key for OpenAI or an OpenAI-compatible server (provider "OpenAI-compatible").
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint. Must be https://, or http://localhost for a
# local server (Ollama, LM Studio…). Only used while the Base URL setting is at its default.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Force the offline mock provider even if keys are present (useful for UI work and tests).
# UNDERTONE_MOCK=1

# Store app data (history, settings, logs) in a custom absolute directory.
# UNDERTONE_USER_DATA=/absolute/path/to/undertone-data

# Verbose main-process logging to the console.
# UNDERTONE_DEBUG=1
